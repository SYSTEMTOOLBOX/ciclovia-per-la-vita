rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // I visitatori non possono mai elencare le adesioni.
    // Un utente puo' leggere soltanto la propria adesione.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function verifiedOwner(uid) {
      return owner(uid) && request.auth.token.email_verified == true;
    }

    // Interruttore amministrativo: il solo flag JavaScript non protegge il backend.
    // Assente o falso = nuove adesioni chiuse. Non impedisce lettura e revoca.
    function collectionOpen() {
      return exists(/databases/$(database)/documents/config/raccolta) &&
        get(/databases/$(database)/documents/config/raccolta).data.enabled == true;
    }

    // Collaudo controllato: nessuna adesione pubblica.
    // Soltanto gli indirizzi email verificati presenti in un elenco
    // amministrativo possono salvare il loro documento durante la prova.
    // Disattivato se il documento e' assente o enabled non e' true.
    function collectionTestAllowed() {
      return exists(/databases/$(database)/documents/config/collaudo) &&
        get(/databases/$(database)/documents/config/collaudo).data.enabled == true &&
        get(/databases/$(database)/documents/config/collaudo).data.testEmails is list &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/collaudo).data.testEmails;
    }

    function validText(value, min, max) {
      return value is string &&
        value.size() >= min && value.size() <= max &&
        value.matches('.*[^ ].*');
    }

    function validAdhesion() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'nome', 'cognome', 'comune', 'email',
          'consensoEsplicito', 'maggiorenne',
          'privacyVersion', 'creataIl'
        ]) &&
        d.keys().hasOnly([
          'nome', 'cognome', 'comune', 'email',
          'consensoEsplicito', 'maggiorenne',
          'privacyVersion', 'creataIl'
        ]) &&
        validText(d.nome, 2, 60) &&
        validText(d.cognome, 2, 60) &&
        validText(d.comune, 2, 80) &&
        d.email is string &&
        d.email == request.auth.token.email &&
        d.consensoEsplicito == true &&
        d.maggiorenne == true &&
        d.privacyVersion == '2026-11-19-v2' &&
        d.creataIl == request.time;
    }

    match /adesioni/{uid} {
      // La lettura del proprio documento serve anche per la revoca quando
      // l'email non risulta piu' verificata: il nuovo inserimento resta vietato.
      allow get: if owner(uid);
      allow list: if false;
      // In collaudo la raccolta pubblica resta spenta. Accesso limitato agli
      // indirizzi autorizzati, sempre verificati e con consenso valido.
      allow create: if verifiedOwner(uid) && validAdhesion() &&
        (collectionOpen() || collectionTestAllowed());
      // Non permettere sostituzioni o alterazioni dopo l'adesione.
      allow update: if false;
      // La revoca deve essere possibile anche con email non piu' verificata.
      allow delete: if owner(uid);
    }

    // Tutte le altre collezioni restano chiuse dal browser.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
